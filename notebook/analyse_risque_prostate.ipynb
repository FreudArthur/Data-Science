    "    chi2, p, dof, expected = stats.chi2_contingency(ct)\n",
    "    # V de Cramér (force de l'association)\n",
    "    n = ct.sum().sum()\n",
    "    cramers_v = np.sqrt(chi2 / (n * (min(ct.shape) - 1)))\n",
    "    results_cat.append({\n",
    "        'variable': col,\n",
    "        'Chi2': round(chi2, 3),\n",
    "        'dof': dof,\n",
    "        'p-value': p,\n",
    "        \"V de Cramér\": round(cramers_v, 3),\n",
    "        'Significatif (p<0.05)': 'Oui' if p < 0.05 else 'Non'\n",
    "    })\n",
    "\n",
    "res_cat_df = pd.DataFrame(results_cat).sort_values('p-value')\n",
    "res_cat_df\n"
   ]
  },
