     "text": [
      "Meilleurs paramètres : {'clf__max_depth': 10, 'clf__min_samples_leaf': 3, 'clf__n_estimators': 400}\n",
      "Meilleur F1-macro (CV) : 0.744\n"
     ]
    }
   ],
   "source": [
    "from sklearn.model_selection import GridSearchCV\n",
    "\n",
    "pipe_rf = Pipeline([('prep', preprocessor),\n",
    "                     ('clf', RandomForestClassifier(class_weight='balanced', random_state=42))])\n",
    "\n",
    "param_grid = {\n",
    "    'clf__n_estimators': [200, 400],\n",
    "    'clf__max_depth': [None, 5, 10],\n",
    "    'clf__min_samples_leaf': [1, 3, 5],\n",
    "}\n",
    "\n",
    "grid = GridSearchCV(pipe_rf, param_grid, cv=cv, scoring='f1_macro', n_jobs=-1)\n",
    "grid.fit(X_train, y_train)\n",
    "\n",
    "print(\"Meilleurs paramètres :\", grid.best_params_)\n",
    "print(f\"Meilleur F1-macro (CV) : {grid.best_score_:.3f}\")\n",
    "\n",
    "best_model = grid.best_estimator_\n"
   ]
  },
