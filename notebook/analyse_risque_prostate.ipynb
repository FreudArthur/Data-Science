    "results_num = []\n",
    "for col in num_cols:\n",
    "    groups = [df.loc[df[target] == lvl, col] for lvl in order_risk]\n",
    "\n",
    "    # ANOVA (paramétrique)\n",
    "    f_stat, p_anova = stats.f_oneway(*groups)\n",
    "    # Kruskal-Wallis (non paramétrique)\n",
    "    h_stat, p_kw = stats.kruskal(*groups)\n",
    "\n",
    "    results_num.append({\n",
    "        'variable': col,\n",
    "        'ANOVA F': round(f_stat, 3), 'ANOVA p-value': p_anova,\n",
    "        'Kruskal-Wallis H': round(h_stat, 3), 'Kruskal-Wallis p-value': p_kw,\n",
    "        'Significatif (p<0.05)': 'Oui' if p_kw < 0.05 else 'Non'\n",
    "    })\n",
    "\n",
    "res_num_df = pd.DataFrame(results_num)\n",
    "res_num_df\n"
   ]
